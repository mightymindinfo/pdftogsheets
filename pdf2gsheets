{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":16565507,"datasetId":10606593,"databundleVersionId":17572546},{"sourceType":"datasetVersion","sourceId":16565762,"datasetId":10606756,"databundleVersionId":17572824}],"dockerImageVersionId":31400,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import os\nimport json\nfrom pypdf import PdfReader\nimport google.generativeai as genai\nfrom kaggle_secrets import UserSecretsClient\nimport gspread\nfrom google.oauth2.service_account import Credentials\n\n# ==========================================\n# 1. CORE PIPELINE SETUP & AUTH\n# ==========================================\ntry:\n    user_secrets = UserSecretsClient()\n    api_key = user_secrets.get_secret(\"GOOGLE_AI_STUDIO_API\")\n    genai.configure(api_key=api_key)\n    print(\"🧠 Gemini API configured successfully!\")\nexcept Exception as e:\n    print(f\"❌ Gemini Key missing: {e}\")\n\nCREDENTIALS_PATH = '/kaggle/input/datasets/mightymind/google-sheets-credentials/credentials.json.json'\nscopes = ['https://www.googleapis.com/auth/spreadsheets', 'https://www.googleapis.com/auth/drive']\n\n# PASTE YOUR TARGET SPREADSHEET ID HERE:\nTARGET_SPREADSHEET_ID = '1gT4XXDADGH03Gj06EHhccJKFQDqHSVyzrootjwfJz9o'\n\n# PASTE YOUR UPLOADED KAGGLE PDF FILE PATH HERE:\nPDF_FILE_PATH = '/kaggle/input/datasets/mightymind/pdf-test1/EBill_250528.pdf'\n\n# ==========================================\n# 2. CHOOSE YOUR TARGET COLUMNS\n# ==========================================\n# Change these to match the type of data you expect in your uploaded PDF!\nUSER_DEFINED_COLUMNS = [\"Date\", \"Item Description\", \"Quantity\", \"Amount\"]\n\n# ==========================================\n# 3. EXTRACT TEXT FROM PHYSICAL PDF\n# ==========================================\nprint(\"📄 Opening PDF and extracting raw text pages...\")\nextracted_text = \"\"\n\ntry:\n    reader = PdfReader(PDF_FILE_PATH)\n    for i, page in enumerate(reader.pages):\n        page_text = page.extract_text()\n        extracted_text += f\"\\n--- PAGE {i+1} ---\\n{page_text}\"\n    print(f\"✅ Successfully read {len(reader.pages)} page(s) from the PDF.\")\nexcept Exception as pdf_err:\n    print(f\"❌ Failed to read PDF file: {pdf_err}\")\n\n# ==========================================\n# 4. THE EXTRACTION AGENT ENGINE\n# ==========================================\ndef extract_and_map_table_via_gemma(raw_text, target_columns):\n    prompt = f\"\"\"\n    You are an expert data migration agent. Analyze the unstructured document text below.\n    Identify any tabular data and extract it.\n    \n    You MUST standardize the table headers. Force-map the extracted rows strictly into these keys:\n    {target_columns}\n    \n    If the document uses different header words, use your intelligence to map them contextually to the requested keys.\n    \n    Return the result STRICTLY as a valid JSON array of objects. \n    Do not write any markdown code blocks, intro sentences, or conversational text. Return raw valid JSON text only.\n    \n    Unstructured Document Text:\n    {raw_text}\n    \"\"\"\n    \n    model = genai.GenerativeModel('gemini-2.0-flash')\n    response = model.generate_content(prompt)\n    \n    cleaned_json_text = response.text.strip()\n    if cleaned_json_text.startswith(\"```json\"):\n        cleaned_json_text = cleaned_json_text.split(\"```json\")[1].split(\"```\")[0].strip()\n    elif cleaned_json_text.startswith(\"```\"):\n        cleaned_json_text = cleaned_json_text.split(\"```\")[1].split(\"```\")[0].strip()\n        \n    return json.loads(cleaned_json_text)\n\n# ==========================================\n# 5. EXECUTE AND BATCH UPLOAD\n# ==========================================\nif extracted_text:\n    try:\n        print(\"🚀 Sending real PDF text to Gemma for processing...\")\n        structured_rows = extract_and_map_table_via_gemma(extracted_text, USER_DEFINED_COLUMNS)\n        print(f\"✅ Gemma extracted {len(structured_rows)} structured rows from your file.\")\n        \n        # Connect to Google Sheets\n        creds = Credentials.from_service_account_file(CREDENTIALS_PATH, scopes=scopes)\n        gc = gspread.authorize(creds)\n        sh = gc.open_by_key(TARGET_SPREADSHEET_ID)\n        worksheet = sh.get_worksheet(0)\n        \n        # Clear previous test data\n        worksheet.clear()\n        \n        # Build batch matrix\n        master_batch = []\n        master_batch.append(USER_DEFINED_COLUMNS)\n        for row in structured_rows:\n            row_values = [row.get(col, \"\") for col in USER_DEFINED_COLUMNS]\n            master_batch.append(row_values)\n            \n        print(\"📦 Batch uploading rows to Google Sheets...\")\n        worksheet.append_rows(master_batch)\n        \n        print(\"\\n🎉 SUCCESS! The entire backend pipeline works on real files!\")\n        print(\"Check your Google Sheet to verify that the data from your PDF was parsed and mapped perfectly.\")\n\n    except Exception as run_err:\n        print(f\"❌ Pipeline execution error: {run_err}\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-06-01T04:01:04.042234Z","iopub.execute_input":"2026-06-01T04:01:04.042594Z","iopub.status.idle":"2026-06-01T04:01:04.492587Z","shell.execute_reply.started":"2026-06-01T04:01:04.042564Z","shell.execute_reply":"2026-06-01T04:01:04.491606Z"}},"outputs":[{"name":"stdout","text":"🧠 Gemini API configured successfully!\n📄 Opening PDF and extrac